{
  "name": "splitsms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "sync:site-config": "node scripts/sync-site-config.mjs",
    "validate:wp-plugin": "node scripts/validate-wordpress-plugin.mjs",
    "release:wp-plugin": "node scripts/sync-site-config.mjs && node scripts/verify-wp-plugin-release.mjs",
    "release:wp-plugin-org": "node scripts/sync-site-config.mjs --wordpress-org && node scripts/validate-wordpress-plugin.mjs --wordpress-org",
    "sync:wp-local": "node scripts/sync-wp-local.mjs",
    "watch:wp-local": "node scripts/sync-wp-local.mjs --watch",
    "prebuild": "node scripts/sync-site-config.mjs && node scripts/sync-sdks.mjs",
    "sync:sdks": "node scripts/sync-sdks.mjs",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "setup:google-oauth": "node scripts/setup-google-oauth.mjs",
    "seo:gsc-report": "tsx scripts/seo/gsc-report.ts",
    "seo:install-verification": "node scripts/seo/install-verification-file.mjs",
    "seo:ping-sitemap": "node scripts/seo/ping-sitemap.mjs",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "worker:sms": "tsx workers/sms-send.processor.ts",
    "worker:campaigns": "tsx workers/campaign-scheduler.ts",
    "worker:reports": "tsx workers/report-sync.processor.ts",
    "worker:webhooks": "tsx workers/webhook-retry.ts",
    "worker:smpp": "tsx workers/smpp-gateway.ts",
    "worker:google-forms": "tsx workers/google-forms-sms.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.77.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "framer-motion": "^12.40.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.13.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.3",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.8.0",
    "smpp": "^0.6.0-rc.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "googleapis": "^174.0.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}

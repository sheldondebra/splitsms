generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  RESELLER
  ENTERPRISE
  ADMIN
  SUPER_ADMIN
}

enum MessagePriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum SlaTier {
  STANDARD
  BUSINESS
  ENTERPRISE
}

enum EnterpriseStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PaymentMethod {
  PAYSTACK
  FLUTTERWAVE
  STRIPE
  MTN_MOMO
  MANUAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum TransactionType {
  WALLET_TOPUP
  CREDIT_PURCHASE
  SMS_DEBIT
  REFUND
  ADMIN_ADJUSTMENT
  PROMO_CREDIT
  RESELLER_SUB_FUND
}

enum ResellerStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum PromoCodeType {
  PERCENT_BONUS
  FIXED_CREDIT
  WALLET_BONUS
}

enum InvoiceStatus {
  DRAFT
  PAID
  VOID
}

enum SmsProviderType {
  INFOBIP
  TWILIO
  MNOTIFY
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  REJECTED
  EXPIRED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  CANCELLED
  PAUSED
}

enum CampaignRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM_DAYS
}

enum AutomationTrigger {
  MANUAL
  SIGNUP
  BIRTHDAY
  LOW_BALANCE
  CAMPAIGN_COMPLETE
}

enum SenderIdStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SenderIdProviderType {
  MNOTIFY
  TWILIO
  INFOBIP
}

enum SenderIdProviderStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
  SKIPPED
}

enum MemberAccountStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum OtpPurpose {
  SIGNUP_VERIFY
  LOGIN
  PASSWORD_RESET
}

enum NotificationType {
  LOW_BALANCE
  CAMPAIGN_COMPLETED
  SMS_FAILED
  WALLET_FUNDED
  OTP_SENT
  SYSTEM
}

model User {
  id               String          @id @default(cuid())
  accountNumber    Int?            @unique
  fullName         String
  phone            String          @unique
  countryCode      String
  passwordHash     String
  role             UserRole        @default(MEMBER)
  referralCode     String?
  email            String?         @unique
  isVerified       Boolean         @default(false)
  failedLoginCount Int             @default(0)
  lockedUntil      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  wallet         Wallet?
  smsCredit      SmsCredit?
  transactions   Transaction[]
  payments       Payment[]
  contacts       Contact[]
  contactGroups  ContactGroup[]
  campaigns      Campaign[]
  messages       Message[]
  senderIds      SenderId[]
  apiKeys        ApiKey[]
  otpSessions    OtpSession[]
  supportTickets    SupportTicket[]
  supportReplies    SupportTicketReply[] @relation("SupportReplies")
  auditLogs         AuditLog[]         @relation("AuditActor")
  webhookEndpoints  WebhookEndpoint[]
  apiLogs           ApiLog[]
  sessions          UserSession[]
  notifications     Notification[]
  smsTemplates      SmsTemplate[]
  automations       AutomationWorkflow[]
  customPricing     UserSmsPricing[]
  invoices          Invoice[]
  promoRedemptions  PromoRedemption[]
  reseller          Reseller?
  resellerMembership ResellerUser?
  enterpriseAccount EnterpriseAccount?
  wordpressSites   WordPressSite[]
  wordpressLogs    WordPressLog[]
  memberAccount    MemberAccount?
  connectCustomersAsPartner ConnectCustomer[] @relation("ConnectPartner")
  connectCustomerProfile    ConnectCustomer?  @relation("ConnectCustomer")
  smartForms                SmartForm[]
  smartFormResponses        SmartFormResponse[]
  smartFormAnalyticsEvents  SmartFormAnalyticsEvent[]
  smartFormExports          SmartFormExport[]
}

model MemberAccount {
  userId           String              @id
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           MemberAccountStatus @default(ACTIVE)
  suspendedReason  String?
  suspendedAt      DateTime?
  maxSenderIds     Int                 @default(5)
  senderIdsBlocked Boolean             @default(false)
  assignedProvider SmsProviderType?
  featureApi       Boolean             @default(true)
  featureCampaigns Boolean             @default(true)
  featureWebhooks  Boolean             @default(true)
  featureBulkSms   Boolean             @default(true)
  featureWordPress Boolean             @default(true)
  adminNote        String?
  onboardingCompletedAt DateTime?
  updatedAt        DateTime            @updatedAt
  updatedById      String?

  @@index([status])
}

model Reseller {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName   String
  brandName      String?
  domain         String?        @unique
  commissionRate Decimal        @default(10) @db.Decimal(5, 2)
  status         ResellerStatus @default(PENDING)
  isActive       Boolean        @default(true)
  dailySmsLimit  Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subUsers       ResellerUser[]
  commissions    ResellerCommission[]
  countryPricing ResellerCountryPricing[]
  branding       WhiteLabelBrand?

  @@index([status])
}

model ResellerUser {
  id            String   @id @default(cuid())
  resellerId    String
  reseller      Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailySmsLimit Int?
  isSuspended   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([resellerId])
}

model ResellerCountryPricing {
  id          String   @id @default(cuid())
  resellerId  String
  reseller    Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  countryCode String
  sellPrice   Decimal  @db.Decimal(10, 4)
  currency    String   @default("GHS")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([resellerId, countryCode])
}

model ResellerCommission {
  id          String    @id @default(cuid())
  resellerId  String
  reseller    Reseller  @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  amount      Decimal   @db.Decimal(14, 4)
  currency    String    @default("GHS")
  source      String
  referenceId String?
  metadata    Json?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([resellerId, createdAt])
  @@index([resellerId, paidAt])
}

model WhiteLabelBrand {
  id             String   @id @default(cuid())
  resellerId     String   @unique
  reseller       Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  logoUrl        String?
  primaryColor   String?  @default("#f97316")
  secondaryColor String?  @default("#0f0f0f")
  accentColor    String?
  supportEmail   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([userId])
}

model OtpSession {
  id        String     @id @default(cuid())
  phone     String
  codeHash  String
  purpose   OtpPurpose @default(SIGNUP_VERIFY)
  expiresAt DateTime
  attempts  Int        @default(0)
  verified  Boolean    @default(false)
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([phone, purpose])
}

model AuthAttempt {
  id           String    @id @default(cuid())
  key          String    @unique
  attempts     Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  currency  String   @default("GHS")
  updatedAt DateTime @updatedAt
}

model SmsCredit {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Transaction {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           TransactionType
  amount         Decimal         @db.Decimal(14, 2)
  currency       String          @default("GHS")
  credits        Int?
  description    String?
  reference      String?
  status         String          @default("completed")
  balanceBefore  Decimal?        @db.Decimal(14, 2)
  balanceAfter   Decimal?        @db.Decimal(14, 2)
  metadata       Json?
  paymentId      String?
  payment        Payment?        @relation(fields: [paymentId], references: [id])
  createdAt      DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([reference])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(14, 2)
  currency          String        @default("GHS")
  providerReference String?       @unique
  proofUrl          String?
  adminNote         String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  transactions      Transaction[]

  @@index([userId, status])
  @@index([method, status])
}

model Country {
  id       String       @id @default(cuid())
  code     String       @unique
  name     String
  dialCode String
  isActive Boolean      @default(true)
  routes   SmsRoute[]
  pricing  SmsPricing[]
}

model SmsPricing {
  id            String  @id @default(cuid())
  countryId     String  @unique
  country       Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  provider      String  @default("mNotify")
  creditsPerSms Int     @default(1)
  costPrice     Decimal  @default(0.02) @db.Decimal(10, 4)
  memberPrice   Decimal  @db.Decimal(10, 4)
  resellerPrice Decimal? @db.Decimal(10, 4)
  currency      String   @default("GHS")
  isActive      Boolean  @default(true)
  updatedAt     DateTime @default(now()) @updatedAt
}

model UserSmsPricing {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryCode String
  sellPrice   Decimal  @db.Decimal(10, 4)
  currency    String   @default("GHS")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, countryCode])
  @@index([userId])
}

model Invoice {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNo     String        @unique
  amount        Decimal       @db.Decimal(14, 2)
  currency      String        @default("GHS")
  status        InvoiceStatus @default(PAID)
  items         Json
  paymentId     String?
  transactionId String?
  createdAt     DateTime      @default(now())

  @@index([userId, createdAt])
}

model PromoCode {
  id        String        @id @default(cuid())
  code      String        @unique
  type      PromoCodeType
  value     Decimal       @db.Decimal(14, 2)
  maxUses   Int?
  usedCount Int           @default(0)
  expiresAt DateTime?
  isActive  Boolean       @default(true)
  userId    String?
  createdAt DateTime      @default(now())
  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, promoCodeId])
}

model SmsProvider {
  id       String          @id @default(cuid())
  type     SmsProviderType @unique
  name     String
  isActive Boolean         @default(true)
  config   Json?
  steps    SmsRouteStep[]
}

model SmsRoute {
  id        String         @id @default(cuid())
  countryId String         @unique
  country   Country        @relation(fields: [countryId], references: [id], onDelete: Cascade)
  steps     SmsRouteStep[]
  isActive  Boolean        @default(true)
}

model SmsRouteStep {
  id         String      @id @default(cuid())
  routeId    String
  route      SmsRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  providerId String
  provider   SmsProvider @relation(fields: [providerId], references: [id])
  priority   Int

  @@unique([routeId, priority])
}

model Contact {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  phone       String
  email       String?
  countryCode String?
  tags        String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  groups      ContactGroupMember[]

  @@unique([userId, phone])
  @@index([userId, phone])
  @@index([userId, countryCode])
  @@index([userId, createdAt])
}

model ContactGroup {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     ContactGroupMember[]
  campaigns   Campaign[]
  smartForms  SmartForm[]
}

model SmsTemplate {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  content    String
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model AutomationWorkflow {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  trigger   AutomationTrigger @default(MANUAL)
  message   String
  isActive  Boolean           @default(true)
  config    Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, isActive])
}

model ContactGroupMember {
  id        String       @id @default(cuid())
  groupId   String
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([groupId, contactId])
}

model Campaign {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  senderId         String
  message          String
  status           CampaignStatus     @default(DRAFT)
  scheduledAt      DateTime?
  timezone         String             @default("UTC")
  contactGroupId   String?
  contactGroup     ContactGroup?      @relation(fields: [contactGroupId], references: [id])
  recipientCount   Int                @default(0)
  estimatedCost    Decimal?           @db.Decimal(14, 2)
  countryCode      String             @default("GH")
  recipientsText   String?
  recurrence       CampaignRecurrence @default(NONE)
  recurrenceDays   Int?
  recurrenceEndAt  DateTime?
  parentCampaignId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  messages         Message[]

  @@index([userId, status])
  @@index([status, scheduledAt])
}

model Message {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId    String?
  campaign      Campaign?        @relation(fields: [campaignId], references: [id])
  recipient     String
  body          String
  countryCode   String?
  isSandbox     Boolean          @default(false)
  status        MessageStatus    @default(PENDING)
  cost          Decimal?         @db.Decimal(10, 4)
  smsUnits      Int              @default(1)
  providerType  SmsProviderType?
  providerRef   String?
  senderId      String
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  failureReason String?
  priority      MessagePriority  @default(MEDIUM)
  channel       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  routingLogs   SmsRoutingLog[]

  @@index([userId, status, createdAt])
  @@index([campaignId])
  @@index([priority, status])
}

model SmsRoutingLog {
  id               String           @id @default(cuid())
  messageId        String?
  message          Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  recipient        String?
  recipientCountry String?
  routeCountry     String
  providerOrder    Json
  selectedProvider SmsProviderType?
  attempts         Json?
  reason           String
  autoRouted       Boolean          @default(false)
  createdAt        DateTime         @default(now())

  @@index([createdAt])
  @@index([messageId])
  @@index([routeCountry, createdAt])
}

model SenderId {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  value               String
  countryCode         String
  status              SenderIdStatus @default(PENDING)
  isDefault           Boolean        @default(false)
  adminNote           String?
  providerStatus      String?
  providerSubmittedAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  providerRegistrations SenderIdProviderRegistration[]

  @@index([userId, status])
}

model SenderIdProviderRegistration {
  id             String                 @id @default(cuid())
  senderId       String
  sender         SenderId               @relation(fields: [senderId], references: [id], onDelete: Cascade)
  provider       SenderIdProviderType
  status         SenderIdProviderStatus @default(PENDING)
  externalRef    String?
  providerStatus String?
  error          String?
  submittedAt    DateTime?
  updatedAt      DateTime               @updatedAt

  @@unique([senderId, provider])
  @@index([senderId])
}

model ApiKey {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label              String
  keyHash            String
  keyPrefix          String
  permissions        String[]  @default(["sms.send", "sms.read", "wallet.read", "contacts.read", "contacts.write", "campaigns.read"])
  isSandbox          Boolean   @default(false)
  rateLimitPerMinute Int       @default(60)
  isActive           Boolean   @default(true)
  lastUsedAt         DateTime?
  createdAt          DateTime  @default(now())
  logs               ApiLog[]

  @@index([userId])
  @@index([keyPrefix])
  @@index([keyHash])
}

model SupportTicket {
  id        String               @id @default(cuid())
  reference Int?                 @unique
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    String               @default("OPEN")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  replies   SupportTicketReply[]

  @@index([userId, status])
  @@index([status, createdAt])
}

model SupportTicketReply {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?         @relation("SupportReplies", fields: [authorId], references: [id])
  body      String
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model PlatformSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  secret    String?
  events    String[] @default(["message.delivered", "message.failed"])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  logs      WebhookDeliveryLog[]

  @@index([userId])
}

model WebhookDeliveryLog {
  id           String          @id @default(cuid())
  endpointId   String
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  statusCode   Int?
  success      Boolean         @default(false)
  retryCount   Int             @default(0)
  nextRetryAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([endpointId, createdAt])
  @@index([success, nextRetryAt])
}

model ApiLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKeyId     String?
  apiKey       ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  method       String
  path         String
  statusCode   Int
  durationMs   Int
  ip           String?
  requestBytes Int?
  errorCode    String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([createdAt])
}

model DedicatedRoute {
  id               String              @id @default(cuid())
  name             String
  countryCode      String
  lockedProvider   SmsProviderType?
  description      String?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  enterpriseAccounts EnterpriseAccount[]

  @@index([countryCode, isActive])
}

model EnterpriseAccount {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName      String
  slaTier          SlaTier           @default(STANDARD)
  status           EnterpriseStatus  @default(PENDING)
  throughputPerSec Int               @default(10)
  ipWhitelist      String[]          @default([])
  apiRateLimit     Int               @default(500)
  dedicatedRouteId String?
  dedicatedRoute   DedicatedRoute?   @relation(fields: [dedicatedRouteId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  smppAccount      SmppAccount?
  credit           EnterpriseCredit?

  @@index([status])
}

model EnterpriseCredit {
  id            String            @id @default(cuid())
  enterpriseId  String            @unique
  enterprise    EnterpriseAccount @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  creditLimit   Decimal           @db.Decimal(14, 2)
  usedCredit    Decimal           @default(0) @db.Decimal(14, 2)
  billingCycle  String            @default("monthly")
  currency      String            @default("GHS")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model SmppAccount {
  id            String            @id @default(cuid())
  enterpriseId  String            @unique
  enterprise    EnterpriseAccount @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  systemId      String            @unique
  passwordHash  String
  throughput    Int               @default(10)
  ipWhitelist   String[]          @default([])
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      SmppSession[]
  submitLogs    SmppSubmitLog[]

  @@index([systemId])
}

model SmppSession {
  id             String      @id @default(cuid())
  smppAccountId  String
  smppAccount    SmppAccount @relation(fields: [smppAccountId], references: [id], onDelete: Cascade)
  bindType       String
  clientIp       String?
  isActive       Boolean     @default(true)
  boundAt        DateTime    @default(now())
  disconnectedAt DateTime?

  @@index([smppAccountId, isActive])
}

model SmppSubmitLog {
  id            String      @id @default(cuid())
  smppAccountId String
  smppAccount   SmppAccount @relation(fields: [smppAccountId], references: [id], onDelete: Cascade)
  messageId     String?
  sourceAddr    String
  destAddr      String
  status        String
  errorCode     String?
  createdAt     DateTime    @default(now())

  @@index([smppAccountId, createdAt])
}

model WordPressSite {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId      String?
  siteUrl       String
  siteName      String?
  wpVersion     String?
  pluginVersion String?
  phpVersion    String?
  status        String         @default("connected")
  lastSyncAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  logs          WordPressLog[]

  @@unique([userId, siteUrl])
  @@index([userId, status])
}

model ConnectCustomer {
  id             String   @id @default(cuid())
  partnerUserId  String
  partner        User     @relation("ConnectPartner", fields: [partnerUserId], references: [id], onDelete: Cascade)
  customerUserId String   @unique
  customer       User     @relation("ConnectCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  externalRef    String?
  label          String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([partnerUserId, externalRef])
  @@index([partnerUserId])
}

model WordPressLog {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId      String?
  site        WordPressSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  event       String
  recipient   String?
  messageType String?
  status      String
  source      String?
  body        String?
  cost        Decimal?       @db.Decimal(10, 4)
  externalRef String?
  messageId   String?
  meta        Json?
  createdAt   DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([siteId, createdAt])
  @@index([status])
}

enum SmartFormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SmartFormFieldType {
  TEXT
  TEXTAREA
  PHONE
  EMAIL
  NUMBER
  SELECT
  RADIO
  CHECKBOX
  DATE
  TIME
  CONSENT
  SECTION
  DIVIDER
}

enum SmartFormAnalyticsEventType {
  VIEW
  UNIQUE_VIEW
  SHORTLINK_CLICK
  OPEN
  SHARE
  QR_SCAN
  SUBMIT
  EXPORT
  EMBED_LOAD
  WORDPRESS_LOAD
  SMS_SENT
  SMS_FAILED
  CONTACT_SAVED
}

enum SmartFormContactSaveStatus {
  PENDING
  SAVED
  SKIPPED
  FAILED
}

enum SmartFormSmsStatus {
  NONE
  SENT
  FAILED
  QUEUED
}

enum SmartFormExportType {
  CSV
  EXCEL
  PDF
}

model SmartForm {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  slug                  String
  shortCode             String         @unique
  description           String?
  status                SmartFormStatus @default(DRAFT)
  logoUrl               String?
  bannerUrl             String?
  themeSettings         Json?
  layoutSettings        Json?
  successSettings       Json?
  contactGroupId        String?
  contactGroup          ContactGroup?  @relation(fields: [contactGroupId], references: [id], onDelete: SetNull)
  saveToContacts        Boolean        @default(false)
  preventDuplicatePhone Boolean        @default(false)
  preventDuplicateEmail Boolean        @default(false)
  captchaEnabled        Boolean        @default(false)
  startsAt              DateTime?
  endsAt                DateTime?
  submissionLimit       Int?
  publishedAt           DateTime?
  closedAt              DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  fields                SmartFormField[]
  responses             SmartFormResponse[]
  analyticsEvents       SmartFormAnalyticsEvent[]
  smsAutomation         SmartFormSmsAutomation?
  exports               SmartFormExport[]

  @@unique([userId, slug])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model SmartFormField {
  id              String             @id @default(cuid())
  formId          String
  form            SmartForm          @relation(fields: [formId], references: [id], onDelete: Cascade)
  label           String
  fieldKey        String
  fieldType       SmartFormFieldType
  placeholder     String?
  helperText      String?
  defaultValue    String?
  isRequired      Boolean            @default(false)
  options         Json?
  validationRules Json?
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  answers         SmartFormResponseAnswer[]

  @@unique([formId, fieldKey])
  @@index([formId, sortOrder])
}

model SmartFormResponse {
  id                String                     @id @default(cuid())
  formId            String
  form              SmartForm                  @relation(fields: [formId], references: [id], onDelete: Cascade)
  userId            String
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId         String?
  source            String?
  deviceType        String?
  ipHash            String?
  userAgent         String?
  referrer          String?
  submittedAt       DateTime                   @default(now())
  contactSaveStatus SmartFormContactSaveStatus @default(PENDING)
  smsStatus         SmartFormSmsStatus         @default(NONE)
  smsError          String?
  reviewedAt        DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  answers           SmartFormResponseAnswer[]

  @@index([formId, submittedAt])
  @@index([userId, submittedAt])
}

model SmartFormResponseAnswer {
  id         String            @id @default(cuid())
  responseId String
  response   SmartFormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  fieldId    String?
  field      SmartFormField?   @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  fieldKey   String
  fieldLabel String
  value      String
  createdAt  DateTime          @default(now())

  @@index([responseId])
}

model SmartFormAnalyticsEvent {
  id         String                      @id @default(cuid())
  formId     String
  form       SmartForm                   @relation(fields: [formId], references: [id], onDelete: Cascade)
  userId     String
  user       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType  SmartFormAnalyticsEventType
  source     String?
  deviceType String?
  referrer   String?
  ipHash     String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime                    @default(now())

  @@index([formId, eventType, createdAt])
  @@index([userId, createdAt])
}

model SmartFormSmsAutomation {
  id                        String    @id @default(cuid())
  formId                    String    @unique
  form                      SmartForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  sendToRespondent          Boolean   @default(false)
  sendToAdmin               Boolean   @default(false)
  adminPhone                String?
  senderId                  String?
  respondentMessageTemplate String?
  adminMessageTemplate      String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model SmartFormExport {
  id         String              @id @default(cuid())
  formId     String
  form       SmartForm           @relation(fields: [formId], references: [id], onDelete: Cascade)
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exportType SmartFormExportType
  fileUrl    String?
  rowCount   Int                 @default(0)
  createdAt  DateTime            @default(now())

  @@index([formId, createdAt])
}
